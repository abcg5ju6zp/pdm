++    @staticmethod
++    def _marker_matches(marker: Any, marker_env: dict[str, Any], extras: set[str]) -> bool:
++        from packaging.markers import UndefinedEnvironmentName
++
++        for extra in extras | {""}:
++            env = dict(marker_env)
++            env["extra"] = extra
++            try:
++                if marker.evaluate(env):
++                    return True
++            except UndefinedEnvironmentName:
++                continue
++        return False
